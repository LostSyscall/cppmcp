@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# cppmcp 对外传递依赖的第三方库
find_dependency(nlohmann_json CONFIG)
find_dependency(asio CONFIG)
find_dependency(llhttp CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/cppmcpTargets.cmake")

# 组件就绪标志，供 check_required_components 校验
# find_package(cppmcp COMPONENTS server client) 形式使用。
set(cppmcp_common_FOUND TRUE)
set(cppmcp_server_FOUND TRUE)
set(cppmcp_client_FOUND TRUE)

check_required_components(cppmcp)
